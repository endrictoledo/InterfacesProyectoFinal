<Window x:Class="InterfacesProyectoFinal.GUISignUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InterfacesProyectoFinal"
        mc:Ignorable="d"
        xmlns:p="clr-namespace:InterfacesProyectoFinal.Properties"
        Title="{x:Static p:Resources.sing_up}" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/fondoMarino2.jpg"
                 Stretch="UniformToFill"></ImageBrush>
        </Grid.Background>
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Width="450"
                    Margin="20,0,0,0">

            <Grid Margin="0,0,0,15" Height="101" Width="447" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Label Content="{x:Static p:Resources.title}" 
                       FontSize="50"
                       Foreground="White"
                       HorizontalAlignment="Center" 
                       Margin="0,23,0,0" 
                       VerticalAlignment="Top" 
                       Width="356" Height="78"/>
            </Grid>
            <StackPanel>
                <Label Content="{x:Static p:Resources.username}"
                       FontSize="14"
                       HorizontalAlignment="Left" 
                       Margin="50,0,0,5" 
                       Width="350" Height="25"/>

                <TextBox 
                        Height="25"
                        Margin="0,0,0,5"
                        Width="350"/>
                <Label Content="{x:Static p:Resources.email}"
                       FontSize="14"
                       HorizontalAlignment="Left" 
                       Margin="50,0,0,5" 
                       Width="350" Height="25"/>

                <TextBox 
                        Height="25"
                        Margin="0,0,0,5"
                        Width="350"/>

                <Label Content="{x:Static p:Resources.password}"
                       FontSize="14"
                       HorizontalAlignment="Left" 
                       Margin="50,0,0,5" 
                       Width="350" Height="25"/>
                <TextBox 
                        Height="25"
                        Margin="0,0,0,5"
                        Width="350"/>
                <Label Content="{x:Static p:Resources.confirm_password}"
                       FontSize="14"
                       HorizontalAlignment="Left" 
                       Margin="50,0,0,5" 
                       Width="350" Height="25"/>

                <TextBox 
                       Height="25"
                       Margin="0,0,0,20"
                       Width="350"/>

                <Button Content="{x:Static p:Resources.login}"
                        Background="#73AB4B"
                        BorderThickness="0"
                        Foreground="White"
                        Height="25" 
                        Margin="0,0,0,30"
                        Width="350"/>
            </StackPanel>
        </StackPanel>
        <Button Content="{x:Static p:Resources.back}"
                Background="#73AB4B"
                BorderThickness="0"
                Foreground="White"
                Height="25" 
                Margin="0,40,20,0"
                Width="100"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"/>

       
        
    </Grid>
</Window>
