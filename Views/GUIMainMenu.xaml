<Window x:Class="InterfacesProyectoFinal.GUIMainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InterfacesProyectoFinal"
        mc:Ignorable="d"
        xmlns:p="clr-namespace:InterfacesProyectoFinal.Properties"
        Title="{x:Static p:Resources.main_menu}" Height="450" Width="800">

    <Grid>
        
        <Grid.Background>
            <ImageBrush ImageSource="/Images/fondoOceano2.jpg" Stretch="UniformToFill"/>
        </Grid.Background>

        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">

            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Width="350">
                <Label Content="{x:Static p:Resources.title}" 
                       FontSize="45" 
                       Foreground="White" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,40"/>

                <Button Content="{x:Static p:Resources.play_online}" 
                        Background="#73AB4B" 
                        BorderThickness="0" 
                        Foreground="White" 
                        Height="25" 
                        Margin="0,0,0,15"/>

                
                <Button Content="{x:Static p:Resources.play_with_a_friend}" 
                        Background="#73AB4B" 
                        BorderThickness="0" 
                        Foreground="White" 
                        Height="25" 
                        Margin="0,0,0,15" 
                        Click="BtnCerrarVentana_Click"/>
            </StackPanel>

            <Button Content="{x:Static p:Resources.quit}" 
                    Background="#73AB4B" 
                    BorderThickness="0" 
                    Foreground="White" 
                    Height="25" 
                    Padding="10,0"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom" 
                    Margin="30"/>

            <Button Content="{x:Static p:Resources.ranking}" 
                    Background="#73AB4B" 
                    BorderThickness="0" 
                    Foreground="White" 
                    Height="25" 
                    Padding="10,0"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    Margin="30"/>
        </Grid>

        <Border Grid.Column="1" Background="Gray">

            <Grid Margin="20">

                <StackPanel VerticalAlignment="Top">
                    <Grid Height="100" 
                          Width="100" 
                          Background="White" 
                          Margin="0,0,0,20">
                        <Image />
                    </Grid>
                    <Label Content="@Username" 
                           Foreground="White" 
                           HorizontalAlignment="Center" 
                           FontSize="16" 
                           Margin="0,0,0,5"/>
                    <Label Content="Puntos" 
                           Foreground="White" 
                           HorizontalAlignment="Center" 
                           FontSize="16" 
                           Margin="0,0,0,5"/>
                    <Button Content="{x:Static p:Resources.friends}" 
                            Background="#73AB4B" 
                            BorderThickness="0" 
                            Foreground="White" 
                            Height="30"/>
                </StackPanel>

                <Button Content="{x:Static p:Resources.settings}" 
                        Foreground="White"
                        Padding="10,0"
                        Height="25" 
                        Background="#73AB4B" 
                        BorderThickness="0"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Bottom"
                        Click="BtnAbrirSettings_Click"/>

            </Grid>
        </Border>
        <Grid x:Name="MenuSettingsOverlay" 
                Background="#99000000" 
                Visibility="Collapsed">

            <Border Background="#CFD6D9" 
                    Width="300" 
                    Height="350" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">

                <Grid Margin="20">
                    <Button Content="x" 
                            Background="Red" 
                            Foreground="Black" 
                            Width="30" 
                            Height="30" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Top" 
                            BorderThickness="0" 
                            Click="BtnCerrarMenu_Click"/>

                    <Border Background="#9E9E9E" 
                            Height="40" 
                            Width="120" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Top" 
                            Margin="0,0,0,0">

                        <Label Content="{x:Static p:Resources.settings}" 
                               Foreground="White" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Top"
                                
                                Margin="0,50,0,0">
                        
                        <Button Content="{x:Static p:Resources.profile}" 
                                     FontSize="16" 
                                     Margin="70,20,0,0" 
                                     HorizontalAlignment="Left"
                                     Height="30"
                                     Padding="20, 0"
                                     Background="#73AB4B" 
                                     BorderThickness="0" 
                                     Foreground="White"
                                     Click="BtnProfile_Click"/>
                        
                        <Button Content="{x:Static p:Resources.language}" 
                                     FontSize="16" 
                                     Margin="70,10,0,0" 
                                     HorizontalAlignment="Left"
                                     Height="30"
                                     Padding="20, 0"
                                     Background="#73AB4B" 
                                     BorderThickness="0" 
                                     Foreground="White" 
                                     Click="BtnLanguages_Click"/>
                    </StackPanel>
                </Grid>

            </Border>
        </Grid>
        <Grid x:Name="MenuLanguagesOverlay" 
              Background="#99000000" 
              Visibility="Collapsed">

            <Border Background="#CFD6D9" 
                    Width="300" 
                    Height="350" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">

                <Grid Margin="20">
                    <Button Content="x" 
                            Background="Red" 
                            Foreground="Black" 
                            Width="30" 
                            Height="30" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Top" 
                            BorderThickness="0" 
                            Click="BtnCerrarMenuLanguages_Click"/>

                    <Border Background="#9E9E9E" 
                            Height="40" 
                            Width="120" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Top" 
                            Margin="0,0,20,0">

                        <Label Content="{x:Static p:Resources.language}" 
                               Foreground="White" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center" 
                                Margin="0,0,0,0">
                        <RadioButton Content="{x:Static p:Resources.english}" 
                                     FontSize="16" 
                                     Margin="70,0,20,20" 
                                     HorizontalAlignment="Left"/>
                        <RadioButton Content="{x:Static p:Resources.spanish}" 
                                     FontSize="16" 
                                     Margin="70,10,20,20" 
                                     HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>

            </Border>
        </Grid>
        <Grid x:Name="MenuProfileOverlay" 
              Background="#99000000" 
              Visibility="Collapsed">

            
            <Border Background="#CFD6D9" 
                    Width="360" 
                    Height="400 " 
                    
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">

                
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        
                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>
                        
                    </Grid.RowDefinitions>

                
                    <Grid Grid.Row="0" 
                          Margin="0,0,0,20">
                        
                        <Border Background="#9E9E9E" 
                                Height="35" 
                                Width="120" 
                                HorizontalAlignment="Center">
                            
                            <Label Content="{x:Static p:Resources.profile}" 
                                   Foreground="White" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        </Border>
 
                        <Button Content="x" 
                                Background="#D32F2F" 
                                Foreground="Black" 
                                Width="30" Height="30" 
                                BorderThickness="0" 
                                HorizontalAlignment="Right" 
                                Click="BtnCerrarMenuProfile_Click"/>
                    </Grid>
                    
                    <Grid Grid.Row="1" 
                          Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                           
                            <ColumnDefinition Width="*"/>
                           
                        </Grid.ColumnDefinitions>

                        
                        <Grid Grid.Column="0" 
                              Height="100" 
                              Width="100" 
                              Background="White" 
                              VerticalAlignment="Top">
                            
                            <Image Stretch="UniformToFill"/>
                        </Grid>

                        
                        <StackPanel Grid.Column="1" 
                                    Margin="15,0,0,0">
                            <Label Content="{x:Static p:Resources.username}" 
                                   FontSize="12" Padding="0,0,0,2"/>
                            <Label Content="Nombre del usuario"
                                   Height="25" 
                                   Margin="0,0,0,5" 
                                   Background="#A3AEB3" 
                                   BorderThickness="0"/>

                            <Label Content="{x:Static p:Resources.email}" 
                                   FontSize="12" 
                                   Padding="0,0,0,2"/>
                            <Label Content="Correo del usuario"
                                   Height="25" 
                                   Margin="0,0,0,10" 
                                   Background="#A3AEB3" 
                                   BorderThickness="0"/>

                            <Button Content="{x:Static p:Resources.change_password}" 
                                    Background="#73AB4B" 
                                    BorderThickness="0" 
                                    Foreground="White" 
                                    FontWeight="Bold" 
                                    Height="25"/>
                        </StackPanel>
                    </Grid>
 
                    <Button Grid.Row="3" 
                            Content="{x:Static p:Resources.save_changes}" 
                            Background="#73AB4B" 
                            BorderThickness="0" 
                            FontWeight="Bold" 
                            Width="120" 
                            Height="30" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Bottom"/>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>