<Window x:Class="InterfacesProyectoFinal.GUITitleScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:p ="clr-namespace:InterfacesProyectoFinal.Properties"
        Title="{x:Static p:Resources.title_screen}" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/fondoMarino2.jpg"
                        Stretch="UniformToFill"></ImageBrush> 
        </Grid.Background>
        
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="450">
            
            <Grid Margin="0,0,0,30">
                <Label Content="{x:Static p:Resources.title}" 
                       FontSize="50"
                       Foreground="White"
                       HorizontalAlignment="Center" 
                       Margin="0,48,0,0" 
                       VerticalAlignment="Top" 
                       Width="356" Height="78"/>        
            </Grid>

            <StackPanel>
                <Button Content="{x:Static p:Resources.login}"
                        Background="#73AB4B"
                        BorderThickness="0"
                        Foreground="White"
                        Height="25"
                        Margin="0,0,0,30"
                        Width="400"/>
                <Button Content="{x:Static p:Resources.sing_up}"
                        Background="#73AB4B"
                        BorderThickness="0"
                        Foreground="White"
                        Height="25"
                        Margin="0,0,0,30"
                        Width="400"/>
                <Button Content="{x:Static p:Resources.play_as_a_guest}"
                        Background="#73AB4B"
                        BorderThickness="0"
                        Foreground="White"  
                        Height="25"
                        Margin="0,0,0,30"
                        Width="400"/>
                
                <Button Content="{x:Static p:Resources.quit}"
                        Background="#73AB4B"
                        BorderThickness="0"
                        Foreground="White"
                        Height="25" 
                        Margin="0,0,0,30"
                        Width="400"
                        Click="BtnCerrarVentana_Click"/>

            </StackPanel>
        </StackPanel>
        <Button Content="Button" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom"
                Margin="0,0,20,20" 
                />

        <Button Content="{x:Static p:Resources.language}" 
                Background="#73AB4B"
                BorderThickness="0"
                Foreground="White"
                Width="80" Height="25" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Margin="0,0,20,20" 
                Click="BtnAbrirIdiomas_Click"/>

        <Grid x:Name="MenuLanguagesOverlay" 
              Background="#99000000" 
              Visibility="Collapsed">

            <Border Background="#CFD6D9" 
                    Width="300" 
                    Height="350" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">

                <Grid Margin="20">
                    <Button Content="x" 
                    Background="Red" 
                    Foreground="Black" 
                    Width="30" 
                    Height="30" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    BorderThickness="0" 
                    Click="BtnCerrarMenu_Click"/>

                    <Border Background="#9E9E9E" 
                            Height="40" 
                            Width="120" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Top" 
                            Margin="0,0,20,0">
                        
                        <Label Content="Language" 
                               Foreground="White" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center" 
                                Margin="0,50,0,0">
                        <RadioButton Content="English" 
                                     FontSize="16" 
                                     Margin="0,10,20,20" 
                                     HorizontalAlignment="Center"/>
                        <RadioButton Content="Español" 
                                     FontSize="16" 
                                     Margin="0,10,20,20" 
                                     HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

            </Border>
        </Grid>

    </Grid>
</Window>
