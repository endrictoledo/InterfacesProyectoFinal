<Window x:Class="InterfacesProyectoFinal.Views.GUIUpdatePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InterfacesProyectoFinal.Views"
        mc:Ignorable="d"
        xmlns:p="clr-namespace:InterfacesProyectoFinal.Properties"
        Title="{x:Static p:Resources.update_password}" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/fondoMarino2.jpg"
                        Stretch="UniformToFill"></ImageBrush>
        </Grid.Background>
        <StackPanel HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Width="450"
            Margin="20,0,0,0">
            <Grid Margin="0,0,0,30">
                <Label Content="{x:Static p:Resources.update_password}"
               FontSize="30"
               Foreground="Black"
               HorizontalAlignment="Center" 
               Margin="0,20,0,0" 
               VerticalAlignment="Top" 
               Width="356" Height="50"/>
            </Grid>
            
            <StackPanel>

                <Label Content="{x:Static p:Resources.new_password}"
                       FontSize="14"
                       HorizontalAlignment="Left" 
                       Margin="50,0,0,5" 
                       Width="350" Height="25"/>
                
                <TextBox Height="25"
                         Margin="0,0,0,20"
                         Width="350"/>
                
                <Label Content="{x:Static p:Resources.confirm_new_password}"
                       FontSize="14"
                       HorizontalAlignment="Left" 
                       Margin="50,0,0,5" 
                       Width="350" Height="25"/>
                    
                <TextBox Height="25"
                         Margin="0,0,0,20"
                         Width="350"/>

                <Grid Width="350">
                    <Button Content="{x:Static p:Resources.save_new_password}"
                    HorizontalAlignment="Left"
                    Background="#73AB4B"
                    BorderThickness="0"
                    Foreground="White"
                    Padding="6"/>
                    <Button Content="{x:Static p:Resources.cancel}"
                    HorizontalAlignment="Right"
                    Background="#73AB4B"
                    BorderThickness="0"
                    Foreground="White"
                    Padding="6"/>
                </Grid>
            </StackPanel>

        </StackPanel>
        <Label Content="{x:Static p:Resources.title}"
               Foreground="Black"
               FontSize="20"
               Margin="20,40,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"/>
    </Grid>
</Window>
