<Window x:Class="InterfacesProyectoFinal.Views.GUIVerificationCode"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InterfacesProyectoFinal.Views"
        mc:Ignorable="d"
        xmlns:p="clr-namespace:InterfacesProyectoFinal.Properties"
        Title="{x:Static p:Resources.verification_code}" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/fondoMarino2.jpg"
         Stretch="UniformToFill"></ImageBrush>
        </Grid.Background>

        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Width="450"
                    Margin="20,0,0,0">
            <Grid Margin="0,0,0,30">
                <Label Content="{x:Static p:Resources.verification_code}"
                       FontSize="30"
                       Foreground="Black"
                       HorizontalAlignment="Center" 
                       Margin="0,20,0,0" 
                       VerticalAlignment="Top" 
                       Width="356" Height="50"/>
            </Grid>
            <TextBlock TextWrapping="Wrap" 
                       Foreground="Black" 
                       FontSize="14" 
                       Width="350" 
                       Margin="50,0,0,10" 
                       HorizontalAlignment="Left">
    
                <Run Text="{x:Static p:Resources.we_send}"/>
                
                <Run Text="unCorreo@gmail.com" 
                     FontWeight="Bold"/>
                <Run Text="{x:Static p:Resources.enter_it}"/>

            </TextBlock>
            <StackPanel>


                <TextBox 
                        Height="25"
                        Margin="0,0,0,20"
                        Width="350"/>
                <Grid Width="350">
                    <Button Content="{x:Static p:Resources.confirm}"
                            HorizontalAlignment="Left"
                            Background="#73AB4B"
                            BorderThickness="0"
                            Foreground="White"
                            Padding="6"/>
                    <Button Content="{x:Static p:Resources.resend_code}"
                            HorizontalAlignment="Right"
                            Background="#73AB4B"
                            BorderThickness="0"
                            Foreground="White"
                            Padding="6"
                            Margin="0,0,40,0"/>
                    <Label Content="60s"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

        </StackPanel>

        <Button Content="{x:Static p:Resources.back}"
         Background="#73AB4B"
         BorderThickness="0"
         Foreground="White"
         
         Margin="0,40,20,0"
         Padding="6"
         HorizontalAlignment="Right"
         VerticalAlignment="Top"/>
        
        <Label Content="{x:Static p:Resources.title}"
                Foreground="Black"
                FontSize="20"
                Margin="20,40,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"/>
    </Grid>
</Window>
