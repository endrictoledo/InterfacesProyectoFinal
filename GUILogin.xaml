<Window x:Class="InterfacesProyectoFinal.GUILogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InterfacesProyectoFinal"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/fondoMarino2.jpg"
                 Stretch="UniformToFill"></ImageBrush>
        </Grid.Background>
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Width="450"
                    Margin="20,0,0,0">

            <Grid Margin="0,0,0,30">
                <Label Content="Colonia Marina" 
                       FontSize="50"
                       Foreground="White"
                       HorizontalAlignment="Center" 
                       Margin="0,50,0,0" 
                       VerticalAlignment="Top" 
                       Width="356" Height="78"/>
            </Grid>
            <StackPanel>
                <Label Content="Username"
                       FontSize="14"
                       HorizontalAlignment="Left" 
                       Margin="50,0,0,5" 
                       Width="350" Height="25"/>

                <TextBox 
                        Height="25"
                        Margin="0,0,0,20"
                        Width="350"/>

                <Label Content="Password"
                       FontSize="14"
                       HorizontalAlignment="Left" 
                       Margin="50,0,0,5" 
                       Width="350" Height="25"/>
                <TextBox 
                        Height="25"
                        Margin="0,0,0,30"
                        Width="350"/>
                
                <Button Content="Log in"
                        Background="#73AB4B"
                        BorderThickness="0"
                        Foreground="White"
                        Height="25" 
                        Margin="0,0,0,30"
                        Width="350"/>
            </StackPanel>
        </StackPanel>
        <Button Content="Back"
                Background="#73AB4B"
                BorderThickness="0"
                Foreground="White"
                Height="25" 
                Margin="0,40,20,0"
                Width="100"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"/>

        <Button Content="Forgot Password?"
                Background="#73AB4B"
                BorderThickness="0"
                Foreground="White"
                Height="25" 
                Margin="0,0,20,20"
                Width="100"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"/>
            
        <Button Content="Sign up"
                Background="#73AB4B"
                BorderThickness="0"
                Foreground="White"
                Height="25" 
                Margin="0,0,20, 60"
                Width="100"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"/>
    </Grid>
</Window>
